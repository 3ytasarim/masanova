{
  "name": "masanovaai",
  "version": "0.1.0",
  "private": true,
  "description": "MasaNova AI — AI destekli çok kiracılı restoran & kafe platformu (3Y Tasarım & Yazılım Hizmetleri)",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:ai-smoke": "vitest run --config vitest.smoke.config.mts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test:regression": "node scripts/regression.mjs",
    "secrets:scan": "node scripts/secret-scan.mjs",
    "env:check": "tsx scripts/env-check.ts",
    "ai:retention": "tsx scripts/ai-retention.ts",
    "media:cleanup": "tsx scripts/media-cleanup.ts",
    "redis:fake": "node tests/support/fake-redis.ts",
    "load:test": "node scripts/load/run.mjs",
    "load:db": "vitest run --config vitest.load.config.mts",
    "perf:qr": "node scripts/perf/qr-menu.mjs",
    "db:diff": "node scripts/db-diff.mjs",
    "db:baseline:check": "node scripts/db-baseline.mjs check",
    "db:baseline:mark": "node scripts/db-baseline.mjs mark",
    "deploy:check": "tsx scripts/deploy-check.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "redis:smoke": "tsx scripts/redis-smoke.ts",
    "checkpoint:verify": "node scripts/checkpoint-verify.mjs",
    "release:verify": "node scripts/checkpoint-verify.mjs --release",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "clsx": "^2.1.1",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.53.0",
    "next": "^16.4.0",
    "opentype.js": "^1.3.4",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/opentype.js": "^1.3.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "prisma": "^6.19.3",
    "puppeteer-core": "^25.13.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  },
  "packageManager": "npm@11.17.0"
}
