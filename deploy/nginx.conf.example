# MasaNova AI — Nginx ÖRNEK yapılandırması (gerçek sunucuya otomatik uygulanmaz; bkz. docs/production-checklist.md › Nginx)
# Platform + tüm kiracı alt alanları + özel alan adları tek upstream'e gider; uygulama Host başlığına göre yönlendirir.

upstream masanova {
    # PM2 küme kipinde tek port (PM2 dağıtır) ya da birden çok süreç/sunucu. Yapışkan oturum gerekmez (REDIS_URL ile).
    server 127.0.0.1:3000;
    keepalive 64;
}

server {
    listen 443 ssl;
    http2 on;
    server_name masanovai.com *.masanovai.com go.masanovai.com;
    # Özel alan adları için ayrı server blokları / sertifikalar (Let's Encrypt).
    # Joker sertifika (*.masanovai.com) DNS-01 doğrulaması ister. Yollar örnektir:
    ssl_certificate     /etc/letsencrypt/live/masanovai.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/masanovai.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    # Diğer güvenlik başlıkları (CSP, X-Frame-Options, Referrer-Policy …) UYGULAMA tarafından verilir (src/lib/security/headers.ts);
    # burada TEKRARLANMAZ (çift / çelişkili başlık olmasın).

    # Sıkıştırma: metin yanıtları. SSE / NDJSON akışları aşağıdaki konumlarda tamponsuz geçer.
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;
    gzip_min_length 1024;

    # Gövde sınırı: en büyük meşru gövde ~4,2 MB (base64 ses). Uygulama ayrıca rota başına daha küçük sınır uygular.
    client_max_body_size 5m;

    # Host başlığı DEĞİŞTİRİLMEDEN iletilmeli (kiracı çözümlemesi buna dayanır).
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    # İstek kimliği: uygulama günlükleriyle eşleştirme (uygulama gelen değeri doğrular, yoksa üretir).
    proxy_set_header X-Request-Id $request_id;
    proxy_http_version 1.1;
    proxy_set_header Connection "";

    # Varsayılan istek zaman aşımları (normal sayfa / eylem)
    proxy_connect_timeout 5s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;

    location / {
        proxy_pass http://masanova;
    }

    # SSE akışları: tamponlama KAPALI, uzun okuma zaman aşımı (sunucu 25 sn'de bir heartbeat gönderir, saatte bir yeniler)
    location ~ ^/(panel/olaylar|t/[^/]+/akis|t/[^/]+/siparis/[^/]+/akis)$ {
        proxy_pass http://masanova;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3700s;
        add_header X-Accel-Buffering no;
    }

    # Canlı ses (NDJSON akışı): tamponlama kapalı; tur üst süresi uygulamada 60 sn
    location ~ ^/t/[^/]+/asistan/canli$ {
        proxy_pass http://masanova;
        proxy_buffering off;
        proxy_request_buffering on;
        proxy_read_timeout 90s;
    }

    # Görsel yükleme (Sprint 13): kaynak dosya en fazla 15 MB (kapak) + çok parçalı ek payı. Yalnızca bu uç noktada
    # geniş gövde; uygulama gövdeyi akış hâlinde ve tür sınırıyla (ürün / kategori 10 MB, logo 5 MB) yeniden denetler.
    location = /api/v1/media {
        client_max_body_size 16m;
        proxy_request_buffering on;
        proxy_read_timeout 120s;
        proxy_pass http://masanova;
    }

    # Yüklenen görseller: Nginx doğrudan diskten sunar (uygulamaya hiç gitmez). Adresler sürümlü (her yükleme yeni
    # rastgele anahtar) → 1 yıl immutable. Kök UPLOAD_ROOT ile AYNI olmalı. Bu blok yoksa uygulama /media/… rotası sunar.
    # Yalnızca beklenen desen (tenants/<k>/<tür>/<id>/<çıktı>.webp|png) sunulur; dizin listeleme kapalı.
    location ~ ^/media/(tenants/[A-Za-z0-9_-]{16,64}/(logo|hero|categories|products)/[A-Za-z0-9_-]{16,64}/[a-z0-9]{1,16}\.(webp|png))$ {
        alias /var/lib/masanova/uploads/$1;
        autoindex off;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Content-Security-Policy "default-src 'none'; img-src 'self'; sandbox" always;
        access_log off;
    }

    # Sağlık (ayrıntı, "degraded") ve hazırlık (çekirdek bağımlılıklar; 503 = trafiği kes). Sır / host içermez.
    location = /api/health {
        proxy_pass http://masanova;
        access_log off;
    }
    location = /api/ready {
        proxy_pass http://masanova;
        access_log off;
    }
}

server {
    listen 80;
    server_name masanovai.com *.masanovai.com go.masanovai.com;
    return 301 https://$host$request_uri;
}
